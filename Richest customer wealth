class Solution {
    public int maximumWealth(int[][] accounts) {
        int n=accounts.length;
        int m=accounts[0].length;
       int max=0;
        for(int i=0;i<n;i++){
             int add=0;
            for(int j=0;j<m;j++){
             add=add+accounts[i][j];
             
            }
            if(add>max){
                max=add;
             }
            
        }
        return max;
    }
}
