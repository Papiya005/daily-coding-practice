class Solution {
    public int smallestIndex(int[] nums) {
      for(int i=0;i<nums.length;i++){
        int digitSum=0;
        while(nums[i]>0){
            digitSum=nums[i]%10+digitSum;
            nums[i]=nums[i]/10;
         }
         if(i==digitSum){
            return i;
         }
        }
      
      return -1;  
    }
}
