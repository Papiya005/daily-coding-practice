import java .util.*;
class Solution {
    public boolean isValid(String s) {
     Stack<Character>S=new Stack<>();
     for(int i=0;i<s.length();i++){
      char ch=s.charAt(i);
      if(ch=='(' || ch=='{' || ch=='['){
        S.push(ch);

      }else{
        if(S.isEmpty()){
            return false;
        }else{
            if((S.peek()=='(' && ch==')')||(S.peek()=='{' && ch=='}')||(S.peek()=='[' && ch==']')){
                S.pop();
            }else{
                return false;
            }
        }
      }
     }
     if(S.isEmpty()){
        return true;
     } 
        return false;
       
    }
}
