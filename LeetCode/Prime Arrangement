class Solution {
      long modulo = 1000000007L;
    public long factorial(int n){
        long fact=1;
        for(int i=1;i<=n;i++){
            fact=(fact*i)%modulo;
        }
        return fact;
    }
    public boolean primeCheck(int n){
        
        boolean isPrime=true;  
      for(int i=2;i<=n-1;i++){
        if(n%i==0){
          isPrime=false;
            
            break;
        }
       
    }
     return isPrime ;
    }
    public int numPrimeArrangements(int n) {
        int primeCount=0;
        for(int i=2;i<=n;i++){
          if(primeCheck(i)){
           primeCount++;
          }
        }
        
       int nonPrime=n-primeCount;
      long p_fact=factorial(primeCount);
      long p_non_fact=factorial(nonPrime);
      
       return (int)((p_fact*p_non_fact)%modulo); 
      }
       
     

}  
    
